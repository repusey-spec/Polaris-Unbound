+++ b/app/src/test/java/com/dd3boh/outertune/utils/StreamCheckTokenlessTest.kt
@@ -0,0 +1,19 @@
+package com.dd3boh.outertune.utils
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class StreamCheckTokenlessTest {
+    @Test fun tokenlessPartial206DoesNotRescueHead403() {
+        assertFalse(StreamCheck.rescueDeniedWebHead(403, 206, false))
+    }
+
+    @Test fun tokenBearingProbeRetainsOriginalFallback() {
+        assertTrue(StreamCheck.rescueDeniedWebHead(403, 206, true))
+    }
+
+    @Test fun deniedProbeDoesNotRescue() {
+        assertFalse(StreamCheck.rescueDeniedWebHead(403, 403, true))
+    }
+}
