@@ -0,0 +1,74 @@
+package com.dd3boh.outertune.polaris
+
+import androidx.media3.common.MediaItem
+import androidx.media3.common.MimeTypes
+import androidx.media3.common.PlaybackException
+import androidx.media3.common.Player
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.media3.exoplayer.source.DefaultMediaSourceFactory
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicReference
+import kotlin.concurrent.thread
+
+/** Prepare real HLS bytes through the final radio factory in the minified APK. */
+@RunWith(AndroidJUnit4::class)
+class PolarisHlsReleaseTest {
+    @Test fun radioHlsReachesReadyInTheReleaseApk() {
+        val instrumentation = InstrumentationRegistry.getInstrumentation()
+        val server = ServerSocket(0, 10, InetAddress.getByName("127.0.0.1"))
+        val assets = instrumentation.context.assets
+        val worker = thread(name = "PolarisHlsFixture", isDaemon = true) {
+            while (!server.isClosed) {
+                runCatching {
+                    server.accept().use { socket ->
+                        socket.soTimeout = 3000
+                        val input = socket.getInputStream().bufferedReader()
+                        val request = input.readLine() ?: return@use
+                        while (!input.readLine().isNullOrEmpty()) { }
+                        val name = request.split(' ')[1].substringBefore('?').substringAfterLast('/')
+                        require(name.matches(Regex("audio(?:[0-9]+\\.ts|\\.m3u8)")))
+                        val bytes = assets.open("hls604/$name").use { it.readBytes() }
+                        val mime = if (name.endsWith("m3u8")) "application/vnd.apple.mpegurl" else "video/mp2t"
+                        socket.getOutputStream().apply {
+                            write("HTTP/1.1 200 OK\r\nContent-Type: $mime\r\nContent-Length: ${bytes.size}\r\nConnection: close\r\n\r\n".toByteArray())
+                            write(bytes); flush()
+                        }
+                    }
+                }
+            }
+        }
+        val ready = CountDownLatch(1)
+        val failure = AtomicReference<PlaybackException?>()
+        var player: ExoPlayer? = null
+        try {
+            instrumentation.runOnMainSync {
+                val context = instrumentation.targetContext
+                val factory = PolarisMediaSources(context, DefaultMediaSourceFactory(context))
+                player = ExoPlayer.Builder(context).setMediaSourceFactory(factory).build().apply {
+                    addListener(object : Player.Listener {
+                        override fun onPlaybackStateChanged(state: Int) { if (state == Player.STATE_READY) ready.countDown() }
+                        override fun onPlayerError(error: PlaybackException) { failure.set(error); ready.countDown() }
+                    })
+                    setMediaItem(MediaItem.Builder().setMediaId("polaris:station:kr1")
+                        .setUri("http://127.0.0.1:${server.localPort}/audio.m3u8")
+                        .setMimeType(MimeTypes.APPLICATION_M3U8).build())
+                    prepare()
+                }
+            }
+            assertTrue("HLS did not reach READY", ready.await(20, TimeUnit.SECONDS))
+            assertNull("HLS preparation failed: ${failure.get()}", failure.get())
+            instrumentation.runOnMainSync { assertEquals(Player.STATE_READY, player!!.playbackState) }
+        } finally {
+            instrumentation.runOnMainSync { player?.release() }
+            server.close(); worker.join(3000)
+        }
+    }
+}
