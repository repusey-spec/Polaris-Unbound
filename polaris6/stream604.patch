+package com.dd3boh.outertune.utils
+
+import okhttp3.OkHttpClient
+import org.junit.Assert.*
+import org.junit.Test
+import java.net.InetAddress
+import java.net.ServerSocket
+import java.util.concurrent.atomic.AtomicReference
+import kotlin.concurrent.thread
+
+/** Real HTTP response bodies, including a misleading 206 and a short body. */
+class WebStreamProbeTest {
+    private fun probe(status: Int, range: String?, bytes: Int = 16, declared: Long = bytes.toLong()): WebStreamProbe.Result {
+        val server = ServerSocket(0, 1, InetAddress.getByName("127.0.0.1"))
+        val serverFailure = AtomicReference<Throwable?>()
+        val worker = thread(isDaemon = true, name = "WebStreamProbeFixture") {
+            try {
+                server.accept().use { socket ->
+                    socket.soTimeout = 2000
+                    val input = socket.getInputStream().bufferedReader()
+                    val headers = mutableListOf<String>()
+                    while (true) {
+                        val line = input.readLine() ?: break
+                        if (line.isEmpty()) break
+                        headers += line
+                    }
+                    assertTrue(headers.any { it.equals("Range: bytes=2097152-2097167", ignoreCase = true) })
+                    val response = buildString {
+                        append("HTTP/1.1 $status Fixture\r\nContent-Length: $declared\r\nConnection: close\r\n")
+                        if (range != null) append("Content-Range: $range\r\n")
+                        append("\r\n")
+                    }
+                    socket.getOutputStream().apply {
+                        write(response.toByteArray()); write(ByteArray(bytes) { 7 }); flush()
+                    }
+                }
+            } catch (failure: Throwable) { serverFailure.set(failure) }
+        }
+        val client = OkHttpClient.Builder().readTimeout(2, java.util.concurrent.TimeUnit.SECONDS).build()
+        return try {
+            val result = WebStreamProbe.read(client, "http://127.0.0.1:${server.localPort}/audio", 2097152)
+            worker.join(3000)
+            assertNull("Fixture failed: ${serverFailure.get()}", serverFailure.get())
+            result
+        } finally {
+            server.close(); worker.join(3000)
+            client.connectionPool.evictAll(); client.dispatcher.executorService.shutdown()
+        }
+    }
+    @Test fun validPartialRangeWithAllBytesIsAccepted() {
+        assertEquals(WebStreamProbe.Result(206, true), probe(206, "bytes 2097152-2097167/4000000"))
+    }
+    @Test fun partialStatusWithoutRangeIsRejected() { assertEquals(WebStreamProbe.Result(206, false), probe(206, null)) }
+    @Test fun partialStatusForTheWrongRangeIsRejected() { assertFalse(probe(206, "bytes 0-15/4000000").verified) }
+    @Test fun truncatedBodyIsRejectedDespitePartialStatus() { assertFalse(probe(206, "bytes 2097152-2097167/4000000", 3, 16).verified) }
+    @Test fun forbiddenGetIsRejected() { assertEquals(WebStreamProbe.Result(403, false), probe(403, null)) }
+    @Test fun ignoredRangeReturningTheWholeResourceIsRejected() { assertFalse(probe(200, null).verified) }
+}
