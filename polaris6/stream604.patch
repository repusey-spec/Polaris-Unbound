diff --git a/app/src/main/java/com/dd3boh/outertune/utils/WebStreamProbe.kt b/app/src/main/java/com/dd3boh/outertune/utils/WebStreamProbe.kt
new file mode 100644
index 0000000..b0824a0
--- /dev/null
+++ b/app/src/main/java/com/dd3boh/outertune/utils/WebStreamProbe.kt
@@ -0,0 +1,40 @@
+package com.dd3boh.outertune.utils
+
+import okhttp3.Call
+import okhttp3.Request
+import java.io.IOException
+
+/** A partial status alone is not proof that the requested audio bytes were served. */
+internal object WebStreamProbe {
+    data class Result(val status: Int?, val verified: Boolean)
+    private val range = Regex("bytes (\\d+)-(\\d+)/(\\d+|\\*)", RegexOption.IGNORE_CASE)
+
+    fun read(calls: Call.Factory, url: String, from: Long): Result {
+        val request = Request.Builder().url(url).header("Range", "bytes=$from-${from + 15}")
+            .header("Accept-Encoding", "identity").build()
+        return try {
+            calls.newCall(request).execute().use { response ->
+                val status = response.code
+                val parts = response.header("Content-Range")?.trim()?.let(range::matchEntire)
+                val correctRange = parts != null && parts.groupValues[1].toLongOrNull() == from &&
+                    parts.groupValues[2].toLongOrNull() == from + 15 &&
+                    (parts.groupValues[3] == "*" || (parts.groupValues[3].toLongOrNull() ?: 0) > from + 15)
+                if (status != 206 || !correctRange) return@use Result(status, false)
+                val body = response.body ?: return@use Result(status, false)
+                val bytes = ByteArray(16)
+                var count = 0
+                try {
+                    val stream = body.byteStream()
+                    while (count < bytes.size) {
+                        val got = stream.read(bytes, count, bytes.size - count)
+                        if (got <= 0) break
+                        count += got
+                    }
+                    Result(status, count == bytes.size)
+                } catch (_: IOException) {
+                    Result(status, false)
+                }
+            }
+        } catch (_: IOException) { Result(null, false) }
+    }
+}
