@@ -0,0 +1,41 @@
+package com.dd3boh.outertune.utils
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class WebStreamRejectionsTest {
+    @Test fun playerRefusalExcludesOnlyTheExactSongScopeAndVariant() {
+        val memory = WebStreamRejections()
+        memory.selected("url-a", "song-a", "account-a", "VIDEO", 0)
+        memory.selected("prefetched", "song-b", "account-a", "VIDEO", 1)
+        assertTrue(memory.reject("url-a", 2))
+        assertTrue(memory.isRejected("song-a", "account-a", "VIDEO", 3))
+        assertFalse(memory.isRejected("song-a", "account-a", "SESSION", 3))
+        assertFalse(memory.isRejected("song-b", "account-a", "VIDEO", 3))
+        assertFalse(memory.isRejected("song-a", "account-b", "VIDEO", 3))
+    }
+    @Test fun duplicateCallbacksDoNotExtendTheRefusal() {
+        val memory = WebStreamRejections(ttlMs = 100)
+        memory.selected("url", "song", "scope", "VIDEO", 0)
+        assertTrue(memory.reject("url", 1))
+        assertFalse(memory.reject("url", 90))
+        assertFalse(memory.isRejected("song", "scope", "VIDEO", 101))
+    }
+    @Test fun unknownCachedOrUnselectedAddressesDoNotRejectAnything() {
+        val memory = WebStreamRejections()
+        assertFalse(memory.reject(null, 0))
+        assertFalse(memory.reject("unknown", 0))
+    }
+    @Test fun selectionsAndRefusalsAreBounded() {
+        val memory = WebStreamRejections(capacity = 2)
+        for (i in 0..2) { memory.selected("u$i", "s$i", "scope", "VIDEO", 0); memory.reject("u$i", 1) }
+        assertFalse(memory.reject("u0", 2))
+        assertFalse(memory.isRejected("s0", "scope", "VIDEO", 2))
+        assertTrue(memory.isRejected("s2", "scope", "VIDEO", 2))
+    }
+    @Test fun expiredSelectionsCannotPoisonNewPlayback() {
+        val memory = WebStreamRejections(ttlMs = 100)
+        memory.selected("url", "song", "scope", "VIDEO", 0)
+        assertFalse(memory.reject("url", 100))
+    }
+}
