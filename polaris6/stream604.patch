+package com.dd3boh.outertune.utils
+
+/** Bounded, process-only feedback from actual playback, separate from successful probes. */
+internal class WebStreamRejections(
+    private val ttlMs: Long = 10 * 60_000L,
+    private val capacity: Int = 128,
+) {
+    private data class Key(val song: String, val scope: String, val variant: String)
+    private data class Choice(val key: Key, val at: Long)
+    private val choices = linkedMapOf<String, Choice>()
+    private val rejected = linkedMapOf<Key, Long>()
+
+    @Synchronized fun selected(url: String, song: String, scope: String, variant: String, now: Long) {
+        prune(now)
+        choices[url] = Choice(Key(song, scope, variant), now)
+        trim(choices)
+    }
+
+    /** The address, not the current/last prefetched song, identifies the failed choice. */
+    @Synchronized fun reject(url: String?, now: Long): Boolean {
+        prune(now)
+        val choice = choices[url] ?: return false
+        if (choice.key in rejected) return false
+        rejected[choice.key] = now
+        trim(rejected)
+        return true
+    }
+
+    @Synchronized fun isRejected(song: String, scope: String, variant: String, now: Long): Boolean {
+        prune(now)
+        return Key(song, scope, variant) in rejected
+    }
+
+    @Synchronized fun clear() { choices.clear(); rejected.clear() }
+
+    private fun prune(now: Long) {
+        choices.entries.removeAll { now - it.value.at >= ttlMs || now < it.value.at }
+        rejected.entries.removeAll { now - it.value >= ttlMs || now < it.value }
+    }
+    private fun <K, V> trim(map: MutableMap<K, V>) {
+        while (map.size > capacity) map.remove(map.keys.first())
+    }
+}
