diff --git a/app/src/main/java/com/dd3boh/outertune/polaris/PolarisRadioLabels.kt b/app/src/main/java/com/dd3boh/outertune/polaris/PolarisRadioLabels.kt
--- /dev/null
+++ b/app/src/main/java/com/dd3boh/outertune/polaris/PolarisRadioLabels.kt
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-3.0
+package com.dd3boh.outertune.polaris
+
+/** The car renders title and artist as two lines, even when both are identical. */
+internal object PolarisRadioLabels {
+    data class Labels(val title: String, val artist: String?)
+
+    fun of(station: String, programmeTitle: String?): Labels {
+        val stationName = station.trim()
+        val title = programmeTitle?.trim()?.takeIf { it.isNotEmpty() } ?: stationName
+        val artist = stationName.takeIf { it.isNotEmpty() && !it.equals(title, ignoreCase = true) }
+        return Labels(title, artist)
+    }
+}
diff --git a/app/src/test/java/com/dd3boh/outertune/polaris/PolarisRadioLabelsTest.kt b/app/src/test/java/com/dd3boh/outertune/polaris/PolarisRadioLabelsTest.kt
--- /dev/null
+++ b/app/src/test/java/com/dd3boh/outertune/polaris/PolarisRadioLabelsTest.kt
@@ -0,0 +1,39 @@
+package com.dd3boh.outertune.polaris
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class PolarisRadioLabelsTest {
+    @Test fun noProgrammeDoesNotRepeatTheStation() {
+        val labels = PolarisRadioLabels.of("91.9 MBC FM4U", "91.9 MBC FM4U")
+        assertEquals("91.9 MBC FM4U", labels.title)
+        assertNull(labels.artist)
+    }
+
+    @Test fun programmeKeepsTheStationOnTheSecondLine() {
+        val labels = PolarisRadioLabels.of("91.9 MBC FM4U", "배철수의 음악캠프")
+        assertEquals("배철수의 음악캠프", labels.title)
+        assertEquals("91.9 MBC FM4U", labels.artist)
+    }
+
+    @Test fun whitespaceAndCaseDoNotProduceAnotherStationLine() {
+        val labels = PolarisRadioLabels.of("Gallery 41", "  GALLERY 41  ")
+        assertEquals("GALLERY 41", labels.title)
+        assertNull(labels.artist)
+    }
+
+    @Test fun missingProgrammeFallsBackToTheStation() {
+        for (programme in listOf(null, "", "  ")) {
+            val labels = PolarisRadioLabels.of("89.1 KBS CoolFM", programme)
+            assertEquals("89.1 KBS CoolFM", labels.title)
+            assertNull(labels.artist)
+        }
+    }
+
+    @Test fun overseasClockRemainsInTheTitle() {
+        val labels = PolarisRadioLabels.of("Gallery 41", "Gallery 41 | SF 08:05")
+        assertEquals("Gallery 41 | SF 08:05", labels.title)
+        assertEquals("Gallery 41", labels.artist)
+    }
+}
